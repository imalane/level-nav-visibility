{
  "name": "level-nav-visibility",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --outfile=dist/main.js",
    "build:dev": "esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --outfile=dist/main.js",
    "watch": "esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --outfile=dist/main.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
